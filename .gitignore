# Dependencies
node_modules/
package-lock.json

# Build output
dist/
*.tsbuildinfo

# Compiled keychain helper + built binaries (rebuild via cli/scripts/build-keychain-helper.sh).
# NOTE: embedded.provisionprofile is a committed INPUT, not a build artifact — it comes from
# developer.apple.com (expires 2044) and the signed-helper build requires it in-tree on EVERY
# home base (release.sh seeds it from the off-main worktree into the tag build). Ignore the
# built artifacts in this dir, but keep the profile tracked so any box can release.
/cli/bin/*
!/cli/bin/embedded.provisionprofile

# Sha pin for the signed standalone CLI binary - a per-release build artifact,
# regenerated by cli/scripts/sign-cli-binary.sh alongside the binary it
# pins. Committing it would go stale against a re-signed binary on every
# publish re-run (unlike the rarely-rebuilt keychain helper's committed pin).
/cli/scripts/agents-cli-bin.sha256

# Caches
.npm-cache/

# Logs
*.log

# Environment / secrets
.env
.env.*

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Test coverage
coverage/

# Generated test reports (session-tracker scenario recorder, run-report aggregator)
**/tests/reports/

# Dated HTML from `bun scripts/code-map.ts` (regenerate locally; do not commit)
/reports/

# Durable agent artifacts (plans, reports, visuals) are committed under
# .agents/artifacts/<yyyy-mm-dd>/; worktrees and scratch stay local.
# .agents/artifacts/private/ is the one artifacts subtree that never lands: it
# holds personal data (contact lists, message-derived context) that the
# "everything committed here is public" rule in AGENTS.md forbids checking in.
.agents/worktrees/
.agents/scratch/
.agents/artifacts/private/
.plans/

# Local release-proof store: release-attestation-produce.sh (the interim
# attestation producer, RUSH-2749) writes the exact-tree attestation JSON +
# pretested tarball here, and release.sh reads it from the same dir. It is a
# machine-local build cache, never committed — without this it surfaces in
# `git status` after every release and gets deleted by hand.
/.release-attestations/

# Scrub script lists personal data strings — must not be committed to public repo
scripts/scrub-history.sh

# Other
.refs/
.crabbox/
.rush/
# Local muse state (root only; nested package .config dirs stay tracked)
/.config/

# Agents (recurisve)
# Harness config homes written by `agents` config sync. Keep this list in step
# with the AGENTS registry in cli/src/lib/agents.ts — a harness that syncs
# a dir here but is missing below leaves the tree permanently dirty, which
# blocks scripts/release.sh (it refuses to build a release from a dirty tree).
**/.claude
**/.codex
**/.gemini
**/.factory
**/.grok
**/.kimi-code
**/.opencode
**/.antigravity
**/.cursor
**/.droid
**/.goose
**/.openclaw
**/.eve
**/.tmp
**/.tmp-bun

# Plugin executables — built/installed artifacts, never committed
**/plugins/*/bin/

# Cloudflare Worker local state
**/.wrangler/

# Local scratch / abandoned scaffold (lives in agent-cli-web, not here)
/website/
.e2e-pack-*
